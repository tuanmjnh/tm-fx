accounts.dat
servers.dat
origin.txt

# Compiled MQL5 artifacts
*.ex4
*.ex5

# Local datasets (keep directory placeholders and small curated samples only)
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep

# Local model artifacts
models/candidates/*
!models/candidates/.gitkeep

# Local experiments and generated reports
experiments/*
!experiments/README.md
reports/*
!reports/README.md

# Local databases
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal

# Logs and tool temp caches
logs/
*.log
matplotlib-*/
